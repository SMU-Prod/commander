# Copie para .env.local e preencha com valores reais. Nunca commite .env.local.
# Nenhum valor abaixo é real — são placeholders.

# URL do projeto Supabase. Onde obter: dashboard Supabase > Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave pública (anon) do Supabase, usada no cliente com RLS. Onde obter: dashboard
# Supabase > Settings > API > Project API keys > anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-chave-anon-aqui

# Chave de serviço do Supabase — só servidor, NUNCA expor no cliente. Ignora RLS; usada
# pelas rotas de alertas, relatório mensal e webhook do Asaas. Onde obter: dashboard
# Supabase > Settings > API > Project API keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# URL pública do app em produção (sem barra no fim). Usada em links de convite de
# tripulação, sitemap.xml e robots.txt. Em produção: o domínio custom.
NEXT_PUBLIC_APP_URL=https://commander.soumardivers.com

# Par de chaves VAPID para Web Push. Onde obter: gere localmente com
# `npx web-push generate-vapid-keys` (pacote web-push).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=coloque-a-chave-publica-vapid-aqui
VAPID_PRIVATE_KEY=coloque-a-chave-privada-vapid-aqui

# Segredo que protege as rotas POST /api/alertas/disparar e POST /api/relatorio/mensal
# (header Authorization: Bearer <valor>). Onde obter: você mesmo gera uma string aleatória
# longa (ex.: `openssl rand -hex 24`) e cadastra o mesmo valor como secret no GitHub.
ALERTAS_SEGREDO=coloque-um-segredo-aleatorio-aqui

# Chave da API Resend, para envio de e-mail (alerta é opcional sem ela; relatório mensal
# exige). Onde obter: dashboard Resend > API Keys.
RESEND_API_KEY=coloque-a-chave-resend-aqui

# Chave da API Asaas (cobrança). Onde obter: painel Asaas > Integrações > Chave de API,
# gerada no ambiente correspondente a ASAAS_AMBIENTE (sandbox ou produção).
ASAAS_API_KEY=coloque-a-chave-asaas-aqui

# Ambiente do Asaas: "sandbox" (padrão/testes) ou "producao" (cobrança real).
ASAAS_AMBIENTE=sandbox

# Token que valida o webhook do Asaas (header asaas-access-token em POST
# /api/asaas/webhook). Onde obter: você mesmo define um valor e cadastra o mesmo token
# ao criar o webhook no painel Asaas > Integrações > Webhooks.
ASAAS_WEBHOOK_TOKEN=coloque-o-token-do-webhook-aqui

# Liga o gate de cobrança: com "1", PROP sem assinatura ativa é redirecionado para
# /assinar. Deixe vazio/ausente para manter desligado (ex.: antes da cobrança estar
# pronta em produção).
NEXT_PUBLIC_COBRANCA_ATIVA=

# Chave de projeto do PostHog (analytics). Opcional — sem ela, os eventos viram no-op.
# Onde obter: dashboard PostHog > Project Settings > Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=

# Host do PostHog (ex.: https://us.i.posthog.com ou https://eu.i.posthog.com conforme a
# região do projeto). Opcional — se vazio, o código usa o host US como padrão.
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry (observabilidade de erro, onda 31). Opcional — sem DSN, o SDK NUNCA
# inicializa (nenhuma chamada de rede, nenhum log) — mesmo padrão de no-op
# do PostHog acima. Onde obter: sentry.io > criar projeto Next.js > Settings
# > Client Keys (DSN). Privacidade é requisito, não opção — o app lida com
# GPS/trilha/documento: `sendDefaultPii` fica false (default do SDK) e
# `beforeSend` (lib/observabilidade/sentry-scrub.ts) redige o resto; ver
# comentário completo em instrumentation-client.ts e sentry.server.config.ts.
NEXT_PUBLIC_SENTRY_DSN=
# DSN só-servidor, opcional — se vazio, o servidor usa NEXT_PUBLIC_SENTRY_DSN
# acima. Só preencha se quiser um projeto Sentry separado do cliente.
SENTRY_DSN=
# Só usadas em BUILD (Vercel), pra fazer upload de source map — sem elas o
# build continua funcionando normal, só sem stack trace legível no Sentry.
# Onde obter: sentry.io > Settings > Auth Tokens (escopo project:releases).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Token PUBLICO do Mapbox (pk.*) — o mapa de /navegar e o seletor de ponto do
# parceiro. Opcional: sem ele, as telas degradam com aviso (a trilha continua
# funcionando). Onde obter: account.mapbox.com > Access tokens. Free tier:
# 50.000 map loads/mes — cobre a escala atual com folga.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- App nativo (Capacitor, onda 14) — só lida por `capacitor.config.ts`,
# NUNCA pelo Next (não tem prefixo NEXT_PUBLIC_ de propósito: o shell nativo
# roda em processo Node separado do bundle web, ver docs/APP-NATIVO.md).

# URL que o WebView do app nativo carrega. Em dev: o IP da sua máquina na
# rede local + porta do `next dev` (ex.: http://192.168.15.42:3010) — o
# device/emulador não alcança "localhost". Sem isso definido, cai pra
# NEXT_PUBLIC_APP_URL e depois pro domínio de produção fixo no config.
CAPACITOR_SERVER_URL=

# Origens extras (host, separadas por vírgula) que o WebView pode navegar
# sem sair pro navegador do sistema, além do host de CAPACITOR_SERVER_URL.
# Normalmente vazio — só preencha se testar contra um preview da Vercel
# com host diferente do de produção.
CAPACITOR_ALLOW_NAVIGATION=
